#!/usr/bin/env bash
# wt: resolve where a feature lives (workspace, repo, slug, plans dir) from any
# worktree layout, and drive the spec -> plan -> tdd -> ship chain headlessly.
set -u

MAX_STEPS=40
WT_CHECK_TIMEOUT=${WT_CHECK_TIMEOUT:-1500}
WT_SELF=$(realpath "${BASH_SOURCE[0]}")
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/wt

usage() {
  cat <<'EOF'
usage: wt <command> [args]
  ctx                          workspace/repo/slug/plans for the current directory
  here                         workspace root (lists repos) or repo, for /spec
  slug                         the resolved slug, or nothing
  tdd | ship | plan-ctx        context blocks for the skills; always exit 0
  audit                        check ticked plan steps for the red/green commit shape
  check [--quick]              run this repo's .claude/check (what CI runs); --quick while iterating
  create <slug> [repo]         find or create the slug's worktree; prints its path
  remove <slug>                remove the slug's worktrees and branches if clean and merged
  run <slug> [phase] [repo]    headless plan|tdd|ship|all (default all), per repo in merge order
  build <slug> [phase] [repo]  the same run, detached under systemd; notifies when it needs you
  status [slug]                every feature that has run, or one feature in detail
  watch <slug>                 follow a run live: progress plus one line per session action
  stop <slug>                  stop a detached run
models per phase come from each skill's frontmatter (skills/steps, tdd, ship)
EOF
}

die() { printf 'wt: %s\n' "$*" >&2; exit 1; }

# --- resolution -------------------------------------------------------------

# Sets toplevel, main, repo, workspace, branch. Fails outside git.
resolve_git() {
  toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
  local common
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
  if [ "$(basename "$common")" = .git ]; then
    main=$(dirname "$common")
    repo=$(basename "$main")
  else # bare repo: <ws>/<repo>.git
    main=$common
    repo=$(basename "$common" .git)
  fi
  workspace=$(dirname "$main")
  branch=$(git branch --show-current 2>/dev/null)
}

plans_roots() { # candidate .plans roots, highest priority first
  if [ -n "${WORKSPACE:-}" ]; then printf '%s\n' "$WORKSPACE/.plans"; return; fi
  printf '%s\n%s\n' "$main/.plans" "$workspace/.plans"
}

slug_candidates() { # keys a worktree layout could have used, most specific first; never the repo's name
  { printf '%s\n' "$(basename "$toplevel")" "$(basename "$(dirname "$toplevel")")"
    if [ -n "$branch" ]; then
      local b=${branch#worktree-}
      printf '%s\n%s\n' "${b//\//-}" "${b##*/}"
    fi
  } | grep -vxF -- "$repo"
}

# Sets slug, plans, plandir, tried (plus resolve_git's vars). Fails outside git.
resolve() {
  slug= plans= plandir= tried=
  resolve_git || return 1
  local roots=() r c
  mapfile -t roots < <(plans_roots)
  if [ -n "${WT_SLUG:-}" ]; then
    slug=$WT_SLUG
    for r in "${roots[@]}"; do [ -d "$r/$slug" ] && { plans=$r/$slug; break; }; done
    [ -n "$plans" ] || plans=${roots[0]}/$slug
  else
    while IFS= read -r c; do
      [ -n "$c" ] || continue
      tried="$tried${tried:+, }$c"
      for r in "${roots[@]}"; do
        [ -d "$r/$c" ] && { slug=$c; plans=$r/$c; break 2; }
      done
    done < <(slug_candidates)
  fi
  [ -n "$plans" ] && plandir=$plans/$repo
  return 0
}

default_branch() { # default_branch <repodir>
  local d
  d=$(git -C "$1" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
  if [ -z "$d" ]; then
    git -C "$1" remote set-head origin -a >/dev/null 2>&1
    d=$(git -C "$1" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
  fi
  if [ -z "$d" ]; then # remote HEAD undeterminable: take the conventional names if they exist
    local b
    for b in main master; do
      git -C "$1" show-ref --verify -q "refs/remotes/origin/$b" && { d=origin/$b; break; }
    done
  fi
  printf '%s\n' "${d#origin/}"
}

repo_dir() { # repo_dir <ws> <repo>: the repo's main checkout (or bare dir), never a linked worktree
  if [ -d "$1/$2/.git" ]; then printf '%s\n' "$1/$2"
  elif [ -d "$1/$2.git" ]; then printf '%s\n' "$1/$2.git"
  else return 1
  fi
}

workspace_repos() { # workspace_repos <ws>: git repos directly under ws
  local d
  for d in "$1"/*/; do
    d=${d%/}
    [ -d "$d/.git" ] && printf '%s\n' "$(basename "$d")"
  done
}

find_wt() { # find_wt <slug> <repo> <repodir> <ws>: existing worktree path, if any
  local slug=$1 repo=$2 repodir=$3 ws=$4 p
  for p in "$ws/.worktrees/$slug/$repo" "$repodir/.claude/worktrees/$slug" "$repodir/.worktrees/$slug"; do
    [ -d "$p" ] && { printf '%s\n' "$p"; return 0; }
  done
  git -C "$repodir" worktree list --porcelain 2>/dev/null | awk -v b="refs/heads/$slug" '
    /^worktree /{p=substr($0,10)} /^branch /{if($2==b){print p; exit}}' | grep . && return 0
  return 1
}

# find_or_create_wt <slug> <repo> <repodir> <ws> <plansroot>: prints the worktree path
find_or_create_wt() {
  local slug=$1 repo=$2 repodir=$3 ws=$4 plansroot=$5 target def
  mkdir -p "$plansroot/$slug/$repo"
  find_wt "$slug" "$repo" "$repodir" "$ws" && return 0
  if [ "$plansroot" = "$repodir/.plans" ]; then target=$repodir/.worktrees/$slug; else target=$ws/.worktrees/$slug/$repo; fi
  git -C "$repodir" fetch -q origin 2>/dev/null || true
  def=$(default_branch "$repodir")
  [ -n "$def" ] || die "cannot determine the default branch of $repodir"
  mkdir -p "$(dirname "$target")"
  if git -C "$repodir" show-ref --verify -q "refs/heads/$slug"; then
    git -C "$repodir" worktree add -q "$target" "$slug" || die "worktree add failed for $repo"
  else
    git -C "$repodir" worktree add -q "$target" -b "$slug" "origin/$def" || die "worktree add failed for $repo"
  fi
  printf '%s\n' "$target"
}

# Sets ws and plansroot from the cwd; plans are repo-local when <main>/.plans/<slug> exists.
locate() {
  if resolve_git; then
    ws=$workspace
    if [ -d "$main/.plans/${1:-}" ]; then plansroot=$main/.plans; else plansroot=$ws/.plans; fi
  else
    ws=$PWD; plansroot=$ws/.plans
  fi
}

# --- context blocks ----------------------------------------------------------

show_file() { # show_file <path> <fallback>
  if [ -f "$1" ]; then cat "$1"; else printf '%s\n' "$2"; fi
}

header() {
  if [ -n "$slug" ]; then printf 'Slug: %s\nRepo: %s\nPlan: %s\n' "$slug" "$repo" "$plandir/plan.md"
  else printf 'Slug: unknown (tried: %s)\nRepo: %s\nPlan: NO PLAN FOUND (tried: %s)\n' "$tried" "$repo" "$tried"
  fi
}

cmd_ctx() {
  resolve || { printf 'cwd=%s\n' "$PWD"; return 0; }
  printf 'workspace=%s\nrepo=%s\nslug=%s\nplans=%s\nplandir=%s\nmain=%s\ntoplevel=%s\nbranch=%s\ntried=%s\n' \
    "$workspace" "$repo" "$slug" "$plans" "$plandir" "$main" "$toplevel" "$branch" "$tried"
}

cmd_here() {
  if resolve_git; then
    printf 'mode=repo\nroot=%s\nrepo=%s\nworkspace=%s\n' "$main" "$repo" "$workspace"
  else
    printf 'mode=workspace\nroot=%s\nworkspace=%s\nrepos=%s\n' "$PWD" "$PWD" "$(workspace_repos "$PWD" | paste -sd ' ')"
  fi
}

cmd_slug() { resolve 2>/dev/null && printf '%s\n' "$slug"; return 0; }

cmd_tdd() {
  resolve || { echo "Not in a git repository: $PWD"; return 0; }
  header
  if [ -n "$slug" ]; then show_file "$plandir/plan.md" "NO PLAN FOUND at $plandir/plan.md"; fi
  printf 'Recent commits:\n%s\nWorking tree:\n%s\n' \
    "$(git log --oneline -5 2>/dev/null || echo none)" "$(git status --short 2>/dev/null | grep . || echo clean)"
}

cmd_plan_ctx() {
  resolve || { echo "Not in a git repository: $PWD"; return 0; }
  header
  printf 'Spec:\n%s\nMerge order:\n%s\nExisting plan:\n%s\n' \
    "$(show_file "$plans/spec.md" "NO SPEC")" "$(show_file "$plans/order.md" "single repo")" \
    "$(show_file "$plandir/plan.md" none)"
}

cmd_ship() {
  resolve || { echo "Not in a git repository: $PWD"; return 0; }
  header
  printf 'Spec:\n%s\nMerge order:\n%s\nState:\n%s\n' \
    "$(show_file "$plans/spec.md" "NO SPEC")" "$(show_file "$plans/order.md" "single repo")" \
    "$(show_file "$plans/state.md" none)"
  printf 'Unchecked steps (this repo): %s\n' "$(count '^- \[ \]' "$plandir/plan.md")"
  grep '^ *BLOCKED:' "$plandir/plan.md" 2>/dev/null
  cmd_audit
  local def base
  def=$(default_branch "$main"); [ -n "$def" ] || def=main
  base=$(git merge-base HEAD "origin/$def" 2>/dev/null || git merge-base HEAD "$def" 2>/dev/null)
  printf 'Base: origin/%s\nDiff:\n%s\nRemote: %s\n' "$def" \
    "$( [ -n "$base" ] && git diff --stat "$base..HEAD" 2>/dev/null || echo "(no merge base with origin/$def)")" \
    "$(git remote get-url origin 2>/dev/null || echo none)"
}

cmd_audit() {
  resolve || { echo "Methodology audit: not in a git repository"; return 0; }
  local plan=$plandir/plan.md
  [ -f "$plan" ] || { echo "Methodology audit: no plan at $plan"; return 0; }
  local n=0 checked=0 line shas sha first violations=
  v() { violations="$violations$(printf '\n  step %s: %s' "$n" "$1")"; }
  while IFS= read -r line; do
    case $line in '- [ ]'*|'- [x]'*) n=$((n + 1)) ;; *) continue ;; esac
    [ "${line:0:5}" = '- [x]' ] || continue
    checked=$((checked + 1))
    shas=$(printf '%s' "$line" | sed -n 's/.*(commits: *\([0-9a-f ]*\)).*/\1/p')
    [ -n "$shas" ] || { v "no commits recorded"; continue; }
    for sha in $shas; do
      git merge-base --is-ancestor "$sha" HEAD 2>/dev/null || v "commit $sha is not on this branch"
    done
    case $line in *Check:*) continue ;; esac
    [ "$(printf '%s\n' $shas | wc -l)" -ge 2 ] || { v "needs a test commit and a green commit"; continue; }
    first=${shas%% *}
    git log -1 --format=%s "$first" 2>/dev/null | grep -Eq '^test(\(.*\))?:' || v "first commit is not a test: commit"
  done <"$plan"
  if [ -z "$violations" ]; then echo "Methodology audit: OK ($checked steps)"
  else printf 'Methodology audit: VIOLATIONS%s\n' "$violations"
  fi
}

# --- check -----------------------------------------------------------------------

local_replaces() { # local_replaces <toplevel>: go.mod replaces that point outside the repo
  local top=$1 f old new abs
  command -v go >/dev/null || return 0
  while IFS= read -r f; do
    while IFS=$'\t' read -r old new; do
      case $new in /*) abs=$new ;; *) abs=$(realpath -m "$top/$(dirname "$f")/$new") ;; esac
      case $abs/ in "$top"/*) ;; *) printf '  %s: %s => %s\n' "$f" "$old" "$new" ;; esac
    done < <(go mod edit -json "$top/$f" 2>/dev/null |
      jq -r '.Replace[]? | select(.New.Version == null) | "\(.Old.Path)\t\(.New.Path)"')
  done < <(git -C "$top" ls-files -- ':(glob)**/go.mod')
}

# A repo's .claude/check runs what its CI runs; green means green on CI. A full check that
# passes on a clean tree is remembered per tree, so pushing right after it doesn't rerun it.
cmd_check() {
  local mode=${1:-} top bad stamp tree clean= rc
  case $mode in ''|--quick) ;; *) die "usage: wt check [--quick]" ;; esac
  top=$(git rev-parse --show-toplevel 2>/dev/null) || die "check: not in a git repository"
  top=$(realpath "$top")
  bad=$(local_replaces "$top")
  if [ -n "$bad" ]; then
    printf 'wt check: go.mod replace points outside the repo; CI has no such path:\n%s\n' "$bad" >&2
    return 1
  fi
  [ -x "$top/.claude/check" ] || { echo "wt check: no .claude/check in $top; nothing to run"; return 0; }
  stamp=$(git -C "$top" rev-parse --path-format=absolute --git-path wt-check-ok)
  tree=$(git -C "$top" rev-parse -q --verify 'HEAD^{tree}')
  [ -z "$(git -C "$top" status --porcelain)" ] && clean=1
  if [ -z "$mode" ] && [ -n "$clean" ] && [ -n "$tree" ] && [ "$(cat "$stamp" 2>/dev/null)" = "$tree" ]; then
    echo "wt check: already green at $(git -C "$top" rev-parse --short HEAD)"; return 0
  fi
  (cd "$top" && timeout -k 30 "$WT_CHECK_TIMEOUT" ./.claude/check $mode); rc=$?
  [ "$rc" -ne 124 ] || { echo "wt check: timed out after ${WT_CHECK_TIMEOUT}s" >&2; return 1; }
  [ "$rc" -eq 0 ] || { echo "wt check: red (exit $rc)" >&2; return 1; }
  if [ -z "$mode" ] && [ -n "$clean" ] && [ -z "$(git -C "$top" status --porcelain)" ]; then
    printf '%s\n' "$tree" >"$stamp"
  fi
  echo "wt check: green"
}

# --- worktree lifecycle --------------------------------------------------------

cmd_create() {
  local slug=${1:-} repo=${2:-} repodir
  [ -n "$slug" ] || die "usage: wt create <slug> [repo]"
  locate "$slug"
  if [ -z "$repo" ]; then
    [ -n "${main:-}" ] || die "usage: wt create <slug> <repo> (not inside a repo)"
    repo=$(basename "$main" .git)
  fi
  repodir=$(repo_dir "$ws" "$repo") || die "no repo '$repo' in $ws"
  find_or_create_wt "$slug" "$repo" "$repodir" "$ws" "$plansroot"
}

cmd_remove() {
  local slug=${1:-} repo repodir wt def found=() problems=
  [ -n "$slug" ] || die "usage: wt remove <slug>"
  locate "$slug"
  while IFS= read -r repo; do
    repodir=$(repo_dir "$ws" "$repo") || continue
    wt=$(find_wt "$slug" "$repo" "$repodir" "$ws") || continue
    found+=("$repo:$repodir:$wt")
    [ -z "$(git -C "$wt" status --porcelain 2>/dev/null)" ] || problems="$problems\n  $repo: uncommitted changes in $wt"
    def=$(default_branch "$repodir")
    git -C "$repodir" merge-base --is-ancestor "$slug" "origin/$def" 2>/dev/null || problems="$problems\n  $repo: branch $slug is unmerged into origin/$def"
  done < <(workspace_repos "$ws")
  [ "${#found[@]}" -gt 0 ] || die "no worktrees for $slug under $ws"
  [ -z "$problems" ] || die "refusing to remove $slug:$(printf '%b' "$problems")"
  local entry
  for entry in "${found[@]}"; do
    repo=${entry%%:*}; entry=${entry#*:}; repodir=${entry%%:*}; wt=${entry#*:}
    git -C "$repodir" worktree remove "$wt" && git -C "$repodir" branch -q -d "$slug" && echo "removed $wt"
  done
  rmdir "$ws/.worktrees/$slug" 2>/dev/null || true
}

# --- headless run ----------------------------------------------------------------

plans_for_slug() { # plans_for_slug <slug>: the .plans/<slug> dir for this cwd
  local c
  for c in "$PWD/.plans/$1" "${main:+$main/.plans/$1}" "${workspace:+$workspace/.plans/$1}" "${WORKSPACE:+$WORKSPACE/.plans/$1}"; do
    [ -n "$c" ] && [ -d "$c" ] && { printf '%s\n' "$c"; return 0; }
  done
  return 1
}

count() { local n; n=$(grep -c -- "$1" "$2" 2>/dev/null); printf '%s\n' "${n:-0}"; } # count <regex> <file>
has_unchecked() { grep -q '^- \[ \]' "$1" 2>/dev/null; }
is_blocked() { grep -q '^ *BLOCKED:' "$1" 2>/dev/null; }
blocked_reason() { sed -n 's/^ *BLOCKED: *//p' "$1" 2>/dev/null | head -1; }
first_open() { awk '/^- \[[ x]\]/ {n++} /^- \[ \]/ {print n; exit}' "$1"; } # index of the first unchecked step
order_repos() { sed -n 's/^Merge order: *//p' "$1/order.md" 2>/dev/null | tr ',' '\n' | tr -d ' ' | grep .; }
pr_count() { [ -f "$1/state.md" ] && awk -v r="$2" '$1 == r {n++} END {print n + 0}' "$1/state.md" || echo 0; }

block_step() { # block_step <plan> <reason>: a BLOCKED line under the first unchecked step
  BLOCK_REASON=$2 awk '!done && /^- \[ \]/ {print; print "  BLOCKED: " ENVIRON["BLOCK_REASON"]; done = 1; next} {print}' \
    "$1" >"$1.tmp" && mv "$1.tmp" "$1"
}

progress() { # progress <phase> <repo> <message>: stdout and the feature's run.log
  local line
  printf -v line '%(%H:%M:%S)T [%s] %s: %s' -1 "$1" "$2" "$3"
  printf '%s\n' "$line"
  [ -z "${RUN_PLANS:-}" ] || printf '%s\n' "$line" >>"$RUN_PLANS/run.log"
}
notify() { # notify <message> [urgency]: a desktop notification, best effort
  command -v notify-send >/dev/null 2>&1 && notify-send -a wt -u "${2:-normal}" "wt: $RUN_SLUG" "$1" >/dev/null 2>&1
  return 0
}
fail() { progress "$1" "$2" "FAILED: $3"; notify "$2: $1 FAILED: $3" critical; }
block() { progress "$1" "$2" "BLOCKED: $3"; notify "$2: BLOCKED: $3" critical; }

last_words() { # last_words <repo> <label>: the end of a session's final message, on one line
  local t
  t=$(tr -s '[:space:]' ' ' <"$RUN_PLANS/$1/log/$2.log" 2>/dev/null)
  t=${t# }; t=${t% }
  [ "${#t}" -le 300 ] || t="...${t: -300}"
  printf '%s\n' "${t:-no final message}"
}

next_label() { # next_label <repo> <label>: <label>, or <label>-2, -3... when a rerun would overwrite its log
  local n=1 l=$2
  while [ -e "$RUN_PLANS/$1/log/$l.jsonl" ]; do n=$((n + 1)); l=$2-$n; done
  printf '%s\n' "$l"
}

ACTIVITY_JQ='
def one(s): (s | tostring | gsub("\\s+"; " "))[0:120];
fromjson? |
if .type == "assistant" then
  (if .parent_tool_use_id then "  sub " else "" end) as $who
  | .message.content[]?
  | if .type == "tool_use" then
      "\($who)\(.name) \(one(.input.description // .input.command // .input.file_path // .input.pattern // .input.prompt // .input))"
    elif .type == "text" and $who == "" then "says: \(one(.text))"
    else empty end
elif .type == "result" then
  "result: \(.subtype // "?") \((.duration_ms // 0) / 1000 | floor)s \(.num_turns // 0) turns $\(.total_cost_usd // 0)"
else empty end'

activity() { # activity <who>: one timestamped line per action of a stream-json transcript on stdin
  local line
  jq --unbuffered -Rr "$ACTIVITY_JQ" | while IFS= read -r line; do
    printf '%(%H:%M:%S)T   %s  %s\n' -1 "$1" "$line"
  done
}

session_stats() { # session_stats <repo> <label> <rc> <jsonl>: a sessions.tsv row; sets LAST_STATS
  local stats
  stats=$(jq -R 'fromjson?' "$4" 2>/dev/null | jq -rs '
    ([.[] | select(.type == "result")] | last // {}) as $r
    | ([.[] | select(.type == "assistant" and (.parent_tool_use_id | not)) | .message.usage
        | (.input_tokens // 0) + (.cache_read_input_tokens // 0) + (.cache_creation_input_tokens // 0)]
       | max // 0) as $ctx
    | [($r.num_turns // 0), (($r.duration_ms // 0) / 1000 | floor), ($r.total_cost_usd // 0), $ctx] | @tsv')
  [ -n "$stats" ] || stats=$(printf '0\t0\t0\t0')
  printf '%(%F %T)T\t%s\t%s\t%s\t%s\n' -1 "$1" "$2" "$3" "$stats" >>"$RUN_PLANS/sessions.tsv"
  LAST_STATS=$(awk -F'\t' '{printf "%ds, $%.2f, %dk ctx", $2, $3, ($4 + 500) / 1000}' <<<"$stats")
}

run_step() { # run_step <repo> <label> <prompt> [claude args...]: one headless session
  local repo=$1 label=$2 prompt=$3 dir base rc; shift 3
  dir=$(find_or_create_wt "$RUN_SLUG" "$repo" "$(repo_dir "$RUN_WS" "$repo")" "$RUN_WS" "$RUN_PLANSROOT") || return 1
  base=$RUN_PLANS/$repo/log/$label; mkdir -p "$(dirname "$base")"
  # .jsonl is the full transcript (every tool call and result), .log the final message, and
  # run.log gets one line per action. The session is told its slug: never re-derived.
  (cd "$dir" && WT_SLUG=$RUN_SLUG WORKSPACE=$RUN_ROOT \
    claude -p "$prompt" --add-dir "$RUN_PLANS" --output-format stream-json --verbose "$@" \
      </dev/null 2>"$base.err" 9>&- | tee -p "$base.jsonl" | activity "$repo/$label" >>"$RUN_PLANS/run.log"
    exit "${PIPESTATUS[0]}")
  rc=$?
  { jq -r 'select(.type == "result") | .result // empty' "$base.jsonl" 2>/dev/null
    [ -s "$base.err" ] && { echo "stderr:"; cat "$base.err"; }
  } >"$base.log"
  rm -f "$base.err"
  session_stats "$repo" "$label" "$rc" "$base.jsonl"
  return $rc
}

run_plan() {
  local repo=$1 plan=$RUN_PLANS/$1/plan.md label
  [ -f "$plan" ] && { progress plan "$repo" "exists, skipping"; return 0; }
  progress plan "$repo" started
  label=$(next_label "$repo" plan)
  run_step "$repo" "$label" "/steps" || { fail plan "$repo" "session failed: $(last_words "$repo" "$label")"; return 1; }
  if is_blocked "$plan"; then block plan "$repo" "$(blocked_reason "$plan")"; return 1; fi
  has_unchecked "$plan" || { fail plan "$repo" "no plan written: $(last_words "$repo" "$label")"; return 1; }
  progress plan "$repo" "done ($(count '^- \[ \]' "$plan") steps; $LAST_STATS)"
}

run_tdd() { # one session per step; a session that ticks nothing blocks the plan with its last words
  local repo=$1 plan=$RUN_PLANS/$1/plan.md i=0 before label
  [ -f "$plan" ] || { fail tdd "$repo" "no plan"; return 1; }
  progress tdd "$repo" "starting ($(count '^- \[[ x]\]' "$plan") steps)"
  while [ "$i" -lt "$MAX_STEPS" ] && has_unchecked "$plan" && ! is_blocked "$plan"; do
    i=$((i + 1)); before=$(count '^- \[x\]' "$plan")
    label=$(next_label "$repo" "step-$(printf '%02d' "$(first_open "$plan")")")
    progress tdd "$repo" "step $i"
    run_step "$repo" "$label" "/tdd" || { fail tdd "$repo" "step $i: session failed: $(last_words "$repo" "$label")"; return 1; }
    if ! is_blocked "$plan" && [ "$(count '^- \[x\]' "$plan")" -le "$before" ]; then
      block_step "$plan" "step not finished; the session said: $(last_words "$repo" "$label")"
    fi
    is_blocked "$plan" || progress tdd "$repo" "step $i done ($LAST_STATS)"
  done
  if is_blocked "$plan"; then block tdd "$repo" "$(blocked_reason "$plan")"; return 1; fi
  has_unchecked "$plan" && { fail tdd "$repo" "stopped after $MAX_STEPS sessions with steps left"; return 1; }
  progress tdd "$repo" "done ($(count '^- \[x\]' "$plan")/$(count '^- \[[ x]\]' "$plan"))"
}

run_ship() {
  local repo=$1 plan=$RUN_PLANS/$1/plan.md before label
  if has_unchecked "$plan" || is_blocked "$plan"; then fail ship "$repo" "the plan has unfinished or blocked steps"; return 1; fi
  progress ship "$repo" started
  before=$(pr_count "$RUN_PLANS" "$repo")
  label=$(next_label "$repo" ship)
  run_step "$repo" "$label" "/ship" || { fail ship "$repo" "session failed: $(last_words "$repo" "$label")"; return 1; }
  [ "$(pr_count "$RUN_PLANS" "$repo")" -gt "$before" ] || { fail ship "$repo" "no PR opened: $(last_words "$repo" "$label")"; return 1; }
  progress ship "$repo" "done ($LAST_STATS)"
}

run_phase_parallel() { # run_phase_parallel <fn> <repos...>
  local fn=$1 pids=() rc=0 pid; shift
  for repo in "$@"; do "$fn" "$repo" & pids+=($!); done
  for pid in "${pids[@]}"; do wait "$pid" || rc=1; done
  return $rc
}

repo_lines() { # repo_lines <plans> <repos...>: steps done, BLOCKED question, PR per repo
  local plans=$1 repo plan blocked pr line; shift
  for repo in "$@"; do
    plan=$plans/$repo/plan.md
    line="$repo: $(count '^- \[x\]' "$plan")/$(count '^- \[[ x]\]' "$plan") steps done"
    blocked=$(blocked_reason "$plan")
    pr=$(awk -v r="$repo" '$1 == r {u = $2} END {print u}' "$plans/state.md" 2>/dev/null)
    [ -n "$blocked" ] && line="$line, BLOCKED: $blocked"
    [ -n "$pr" ] && line="$line, PR $pr"
    echo "$line"
  done
}

register() { # remember a feature's plans dir, so wt status finds it from anywhere
  mkdir -p "$STATE_DIR"
  grep -qxF -- "$1" "$STATE_DIR/runs" 2>/dev/null || printf '%s\n' "$1" >>"$STATE_DIR/runs"
}

is_running() { [ -f "$1/.run.lock" ] && ! flock -n "$1/.run.lock" true; } # is_running <plans>

cmd_run() {
  local slug=${1:-} phase=${2:-all} only=${3:-} repos=() repo rc=0
  [ -n "$slug" ] || die "usage: wt run <slug> [plan|tdd|ship|all] [repo]"
  case $phase in plan|tdd|ship|all) ;; *) die "unknown phase '$phase' (plan|tdd|ship|all)" ;; esac
  resolve_git || true
  RUN_SLUG=$slug
  RUN_PLANS=$(plans_for_slug "$slug") || die "no .plans/$slug found; run /spec first"
  RUN_PLANSROOT=$(dirname "$RUN_PLANS")
  RUN_ROOT=$(dirname "$RUN_PLANSROOT")
  if [ -e "$RUN_ROOT/.git" ]; then RUN_WS=$(dirname "$RUN_ROOT"); else RUN_WS=$RUN_ROOT; fi
  export RUN_SLUG RUN_PLANS RUN_PLANSROOT RUN_ROOT RUN_WS
  mapfile -t repos < <(order_repos "$RUN_PLANS")
  [ "${#repos[@]}" -gt 0 ] || die "$RUN_PLANS/order.md has no 'Merge order: repo1, repo2' line"
  if [ -n "$only" ]; then
    printf '%s\n' "${repos[@]}" | grep -qxF -- "$only" || die "repo '$only' is not in the merge order"
    repos=("$only")
  fi
  for repo in "${repos[@]}"; do repo_dir "$RUN_WS" "$repo" >/dev/null || die "no repo '$repo' in $RUN_WS"; done

  exec 9>>"$RUN_PLANS/.run.lock"
  flock -n 9 || die "$slug is already running; wt status $slug"
  echo $$ >"$RUN_PLANS/run.pid"
  if [ -n "${WT_UNIT:-}" ]; then echo "$WT_UNIT" >"$RUN_PLANS/run.unit"; else rm -f "$RUN_PLANS/run.unit"; fi
  unset WT_UNIT
  register "$RUN_PLANS"
  progress run "$slug" "started ($phase${only:+, $only})"

  case $phase in plan|all) run_phase_parallel run_plan "${repos[@]}" || rc=1 ;; esac
  case $phase in tdd|all) [ "$rc" -eq 0 ] && { run_phase_parallel run_tdd "${repos[@]}" || rc=1; } ;; esac
  case $phase in ship|all)
    if [ "$rc" -eq 0 ]; then
      for repo in "${repos[@]}"; do run_ship "$repo" || { rc=1; break; }; done
    fi ;;
  esac
  if [ "$rc" -eq 0 ]; then
    progress run "$slug" "finished $phase"
    notify "finished $phase: $(repo_lines "$RUN_PLANS" "${repos[@]}" | paste -sd ';' | sed 's/;/; /g')"
  else
    progress run "$slug" stopped
  fi
  echo "== $slug =="
  repo_lines "$RUN_PLANS" "${repos[@]}"
  echo "Live log: $RUN_PLANS/run.log; transcripts: $RUN_PLANS/<repo>/log/"
  return $rc
}

env_flags() { # systemd-run -E flags: the caller's environment, minus a Claude session's own
  local v
  for v in $(compgen -e); do
    case $v in CLAUDECODE|CLAUDE_CODE_*|CLAUDE_ENV_FILE|CLAUDE_PROJECT_DIR|WT_UNIT|PWD|OLDPWD|SHLVL|_|TMUX|TMUX_PANE) continue ;; esac
    [[ ${!v} == *$'\n'* ]] && continue
    printf -- '-E\n%s\n' "$v"
  done
}

cmd_build() { # the same run, detached: survives this terminal or Claude session
  local slug=${1:-} plans unit flags=()
  [ -n "$slug" ] || die "usage: wt build <slug> [plan|tdd|ship|all] [repo]"
  resolve_git || true
  plans=$(plans_for_slug "$slug") || die "no .plans/$slug found; run /spec first"
  is_running "$plans" && die "$slug is already running; wt status $slug"
  unit=wt-$slug-$(printf '%s' "$plans" | md5sum | cut -c1-4)
  mapfile -t flags < <(env_flags)
  systemd-run --user --collect --quiet --same-dir --unit="$unit" --description="wt run $*" \
    "${flags[@]}" -E "WT_UNIT=$unit" -- "$WT_SELF" run "$@" || die "systemd-run could not start $unit"
  printf 'started %s in the background (unit %s)\n  wt watch %s    follow it live\n  wt status          every feature\n  wt stop %s     cancel it\n' \
    "$slug" "$unit" "$slug" "$slug"
}

feature_state() { # feature_state <plans>: running, blocked, failed, done (every PR open) or idle
  local plans=$1 p r repos=()
  is_running "$plans" && { echo running; return; }
  for p in "$plans"/*/plan.md; do is_blocked "$p" && { echo blocked; return; }; done
  last_progress "$plans" 1 | grep -q 'FAILED' && { echo failed; return; }
  mapfile -t repos < <(order_repos "$plans")
  [ "${#repos[@]}" -gt 0 ] || { echo idle; return; }
  for r in "${repos[@]}"; do [ "$(pr_count "$plans" "$r")" -gt 0 ] || { echo idle; return; }; done
  echo done
}
last_progress() { grep -E '^[0-9:]{8} \[' "$1/run.log" 2>/dev/null | grep -v '^[0-9:]* \[run\]' | tail -n "${2:-1}"; }

cmd_status() {
  local slug=${1:-} plans state repos=()
  resolve_git || true
  if [ -z "$slug" ]; then
    [ -f "$STATE_DIR/runs" ] || { echo "no runs yet"; return 0; }
    while IFS= read -r plans; do
      [ -f "$plans/run.log" ] || continue
      state=$(feature_state "$plans")
      printf '%-28s %-8s %s\n' "$(basename "$plans")" "$state" "$(last_progress "$plans" 1)"
    done <"$STATE_DIR/runs"
    return 0
  fi
  plans=$(plans_for_slug "$slug") || die "no .plans/$slug found"
  mapfile -t repos < <(order_repos "$plans")
  printf '%s: %s (%s)\n' "$slug" "$(feature_state "$plans")" "$plans"
  repo_lines "$plans" "${repos[@]}"
  awk -F'\t' '{n++; s += $6; c += $7} END {if (n) printf "%d sessions, %dm%02ds, $%.2f\n", n, s / 60, s % 60, c}' \
    "$plans/sessions.tsv" 2>/dev/null
  last_progress "$plans" 5
  is_running "$plans" && printf 'now: %s\n' "$(grep -E '^[0-9:]{8}   ' "$plans/run.log" | tail -1)"
  return 0
}

cmd_watch() {
  local slug=${1:-} plans pid
  [ -n "$slug" ] || die "usage: wt watch <slug>"
  resolve_git || true
  plans=$(plans_for_slug "$slug") || die "no .plans/$slug found"
  [ -f "$plans/run.log" ] || die "$slug has not run yet"
  if is_running "$plans" && pid=$(cat "$plans/run.pid" 2>/dev/null) && [ -n "$pid" ]; then
    tail -n 40 -F --pid="$pid" "$plans/run.log"
  else
    tail -n 40 "$plans/run.log"
  fi
}

cmd_stop() {
  local slug=${1:-} plans
  [ -n "$slug" ] || die "usage: wt stop <slug>"
  resolve_git || true
  plans=$(plans_for_slug "$slug") || die "no .plans/$slug found"
  is_running "$plans" || { echo "$slug is not running"; return 0; }
  [ -f "$plans/run.unit" ] || die "$slug runs in a terminal, not under systemd; stop it there"
  systemctl --user stop "$(cat "$plans/run.unit")"
}

# --- main -------------------------------------------------------------------------

cmd=${1:-}; [ $# -gt 0 ] && shift
case $cmd in
  ctx) cmd_ctx ;;
  here) cmd_here ;;
  slug) cmd_slug ;;
  tdd) cmd_tdd ;;
  ship) cmd_ship ;;
  plan-ctx) cmd_plan_ctx ;;
  audit) cmd_audit ;;
  check) cmd_check "$@" ;;
  create) cmd_create "$@" ;;
  remove) cmd_remove "$@" ;;
  run) cmd_run "$@" ;;
  build) cmd_build "$@" ;;
  status) cmd_status "$@" ;;
  watch) cmd_watch "$@" ;;
  stop) cmd_stop "$@" ;;
  ''|-h|--help|help) usage ;;
  *) usage >&2; die "unknown command '$cmd'" ;;
esac
