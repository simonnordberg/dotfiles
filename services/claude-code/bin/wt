#!/usr/bin/env bash
# wt: resolve where a feature lives (workspace, repo, slug, plans dir) from any
# worktree layout, and drive the spec -> plan -> tdd -> ship chain headlessly.
set -u

MAX_STEPS=40
WT_CHECK_TIMEOUT=${WT_CHECK_TIMEOUT:-1500}
WT_ACCEPTANCE_TIMEOUT=${WT_ACCEPTANCE_TIMEOUT:-1500}
WT_PUSH_TIMEOUT=${WT_PUSH_TIMEOUT:-120}
WT_SELF=$(realpath "${BASH_SOURCE[0]}")
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/wt

usage() {
  cat <<'EOF'
usage: wt <command> [args]
  ctx                          workspace/repo/slug/plans for the current directory
  here                         workspace root (lists repos) or repo, for /spec
  slug                         the resolved slug, or nothing
  tdd | plan-ctx | fix-ctx <check|review|ci>
                               context blocks for the skills; always exit 0
  check [--quick]              run this repo's .claude/check (what CI runs); --quick while iterating
  acceptance [--run|--paths]   run this repo's .claude/acceptance suite (see HANDBOOK.md)
  create <slug> [repo]         find or create the slug's worktree; prints its path
  remove <slug>                remove the slug's worktrees and branches if clean and merged
  run <slug> [phase] [repo]    headless plan|tdd|ship|all (default all), per repo in merge order;
                               ship = rebase, check, review, fixes, e2e, then push and PRs
  build <slug> [phase] [repo]  the same run, detached under systemd; notifies when it needs you
  status [slug]                every feature that has run, or one feature in detail
  watch <slug>                 follow a run live: progress plus one line per session action
  stop <slug>                  stop a detached run
models come from each skill's frontmatter (skills/steps, tdd, fix) and agents/reviewer.md
EOF
}

die() { printf 'wt: %s\n' "$*" >&2; exit 1; }

# --- resolution -------------------------------------------------------------

# Sets toplevel, main, repo, workspace, branch. Fails outside git.
resolve_git() {
  toplevel=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
  local common
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
  if [ "$(basename "$common")" = .git ]; then
    main=$(dirname "$common")
    repo=$(basename "$main")
  else # bare repo: <ws>/<repo>.git
    main=$common
    repo=$(basename "$common" .git)
  fi
  workspace=$(dirname "$main")
  branch=$(git branch --show-current 2>/dev/null)
}

# resolve_workspace <ws>: sets ws_kind (explicit|marked|legacy) and ws_root (the repo that owns
# the plans root: WORKSPACE override, the one child repo with a committed .claude/records, or
# <ws> itself). Two marked repos in one workspace is fatal, naming both.
resolve_workspace() {
  local ws=$1 r marked=()
  if [ -n "${WORKSPACE:-}" ]; then ws_kind=explicit; ws_root=$WORKSPACE; return; fi
  while IFS= read -r r; do
    [ -f "$ws/$r/.claude/records" ] && marked+=("$r")
  done < <(workspace_repos "$ws")
  if [ "${#marked[@]}" -gt 1 ]; then
    die "two records markers in $ws: ${marked[0]} and ${marked[1]}"
  fi
  if [ "${#marked[@]}" -eq 1 ]; then ws_kind=marked; ws_root=$ws/${marked[0]}
  else ws_kind=legacy; ws_root=$ws
  fi
}

plans_roots() { # candidate .plans roots, highest priority first
  resolve_workspace "$workspace"
  case $ws_kind in
    explicit|marked) printf '%s\n' "$ws_root/.plans" ;;
    legacy) printf '%s\n%s\n' "$main/.plans" "$workspace/.plans" ;;
  esac
}

die_if_legacy_slug() { # die_if_legacy_slug <slug>: in a marked workspace, refuse an old .plans/<slug>
  [ "${ws_kind:-}" = marked ] || return 0
  local old
  for old in "${main:-}" "${workspace:-}"; do
    [ -n "$old" ] && [ -d "$old/.plans/$1" ] && die "$1 is in $old/.plans/$1; move it to $ws_root/.plans/$1"
  done
}

slug_candidates() { # keys a worktree layout could have used, most specific first; never the repo's name
  { printf '%s\n' "$(basename "$toplevel")" "$(basename "$(dirname "$toplevel")")"
    if [ -n "$branch" ]; then
      local b=${branch#worktree-}
      printf '%s\n%s\n' "${b//\//-}" "${b##*/}"
    fi
  } | grep -vxF -- "$repo"
}

# Sets slug, plans, plandir, tried (plus resolve_git's vars). Fails outside git.
resolve() {
  slug= plans= plandir= tried=
  resolve_git || return 1
  local roots=() r c
  resolve_workspace "$workspace" # sets ws_kind/ws_root in this scope; plans_roots below reruns it in a subshell
  mapfile -t roots < <(plans_roots)
  if [ -n "${WT_SLUG:-}" ]; then
    slug=$WT_SLUG
    for r in "${roots[@]}"; do [ -d "$r/$slug" ] && { plans=$r/$slug; break; }; done
    if [ -z "$plans" ]; then
      die_if_legacy_slug "$slug"
      plans=${roots[0]}/$slug
    fi
  else
    while IFS= read -r c; do
      [ -n "$c" ] || continue
      tried="$tried${tried:+, }$c"
      for r in "${roots[@]}"; do
        [ -d "$r/$c" ] && { slug=$c; plans=$r/$c; break 2; }
      done
      die_if_legacy_slug "$c"
    done < <(slug_candidates)
  fi
  [ -n "$plans" ] && plandir=$plans/$repo
  return 0
}

default_branch() { # default_branch <repodir>
  local d
  d=$(git -C "$1" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
  if [ -z "$d" ]; then
    git -C "$1" remote set-head origin -a >/dev/null 2>&1
    d=$(git -C "$1" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
  fi
  if [ -z "$d" ]; then # remote HEAD undeterminable: take the conventional names if they exist
    local b
    for b in main master; do
      git -C "$1" show-ref --verify -q "refs/remotes/origin/$b" && { d=origin/$b; break; }
    done
  fi
  printf '%s\n' "${d#origin/}"
}

repo_dir() { # repo_dir <ws> <repo>: the repo's main checkout (or bare dir), never a linked worktree
  if [ -d "$1/$2/.git" ]; then printf '%s\n' "$1/$2"
  elif [ -d "$1/$2.git" ]; then printf '%s\n' "$1/$2.git"
  else return 1
  fi
}

workspace_repos() { # workspace_repos <ws>: git repos directly under ws
  local d
  for d in "$1"/*/; do
    d=${d%/}
    [ -d "$d/.git" ] && printf '%s\n' "$(basename "$d")"
  done
}

find_wt() { # find_wt <slug> <repo> <repodir> <ws>: existing worktree path, if any
  local slug=$1 repo=$2 repodir=$3 ws=$4 p
  for p in "$ws/.worktrees/$slug/$repo" "$repodir/.claude/worktrees/$slug" "$repodir/.worktrees/$slug"; do
    [ -d "$p" ] && { printf '%s\n' "$p"; return 0; }
  done
  git -C "$repodir" worktree list --porcelain 2>/dev/null | awk -v b="refs/heads/$slug" '
    /^worktree /{p=substr($0,10)} /^branch /{if($2==b){print p; exit}}' | grep . && return 0
  return 1
}

# find_or_create_wt <slug> <repo> <repodir> <ws> <plansroot>: prints the worktree path
find_or_create_wt() {
  local slug=$1 repo=$2 repodir=$3 ws=$4 plansroot=$5 target def
  mkdir -p "$plansroot/$slug/$repo"
  find_wt "$slug" "$repo" "$repodir" "$ws" && return 0
  # Repo-local plans get a repo-local worktree, unless the repo is a records root
  # (marked repos always use the workspace layout even though their plans dir matches).
  if [ "$plansroot" = "$repodir/.plans" ] && ! [ -f "$repodir/.claude/records" ]; then target=$repodir/.worktrees/$slug
  else target=$ws/.worktrees/$slug/$repo
  fi
  git -C "$repodir" fetch -q origin 2>/dev/null || true
  def=$(default_branch "$repodir")
  [ -n "$def" ] || die "cannot determine the default branch of $repodir"
  mkdir -p "$(dirname "$target")"
  if git -C "$repodir" show-ref --verify -q "refs/heads/$slug"; then
    git -C "$repodir" worktree add -q "$target" "$slug" || die "worktree add failed for $repo"
  else
    git -C "$repodir" worktree add -q "$target" -b "$slug" "origin/$def" || die "worktree add failed for $repo"
  fi
  printf '%s\n' "$target"
}

# Sets ws and plansroot from the cwd. In a marked workspace, plansroot is always the records
# repo's .plans; otherwise plans are repo-local when <main>/.plans/<slug> exists.
locate() {
  local in_git=
  if resolve_git; then in_git=1; ws=$workspace; else ws=$PWD; fi
  resolve_workspace "$ws"
  case $ws_kind in
    explicit|marked) plansroot=$ws_root/.plans ;;
    legacy)
      if [ -n "$in_git" ] && [ -d "$main/.plans/${1:-}" ]; then plansroot=$main/.plans
      else plansroot=$ws/.plans
      fi ;;
  esac
}

# --- context blocks ----------------------------------------------------------

show_file() { # show_file <path> <fallback>
  if [ -f "$1" ]; then cat "$1"; else printf '%s\n' "$2"; fi
}

header() {
  if [ -n "$slug" ]; then printf 'Slug: %s\nRepo: %s\nPlan: %s\n' "$slug" "$repo" "$plandir/plan.md"
  else printf 'Slug: unknown (tried: %s)\nRepo: %s\nPlan: NO PLAN FOUND (tried: %s)\n' "$tried" "$repo" "$tried"
  fi
}

cmd_ctx() {
  resolve || { printf 'cwd=%s\n' "$PWD"; return 0; }
  printf 'workspace=%s\nrepo=%s\nslug=%s\nplans=%s\nplandir=%s\nmain=%s\ntoplevel=%s\nbranch=%s\ntried=%s\n' \
    "$workspace" "$repo" "$slug" "$plans" "$plandir" "$main" "$toplevel" "$branch" "$tried"
}

cmd_here() {
  if resolve_git; then
    resolve_workspace "$workspace"
    if [ "$ws_kind" = marked ]; then
      printf 'mode=workspace\nroot=%s\nworkspace=%s\nrepos=%s\n' "$ws_root" "$workspace" "$(workspace_repos "$workspace" | paste -sd ' ')"
    else
      printf 'mode=repo\nroot=%s\nrepo=%s\nworkspace=%s\n' "$main" "$repo" "$workspace"
    fi
  else
    resolve_workspace "$PWD"
    if [ "$ws_kind" = marked ]; then
      printf 'mode=workspace\nroot=%s\nworkspace=%s\nrepos=%s\n' "$ws_root" "$PWD" "$(workspace_repos "$PWD" | paste -sd ' ')"
    else
      printf 'mode=workspace\nroot=%s\nworkspace=%s\nrepos=%s\n' "$PWD" "$PWD" "$(workspace_repos "$PWD" | paste -sd ' ')"
    fi
  fi
}

cmd_slug() { resolve 2>/dev/null && printf '%s\n' "$slug"; return 0; }

cmd_tdd() {
  resolve || { echo "Not in a git repository: $PWD"; return 0; }
  header
  if [ -n "$slug" ]; then show_file "$plandir/plan.md" "NO PLAN FOUND at $plandir/plan.md"; fi
  printf 'Recent commits:\n%s\nWorking tree:\n%s\n' \
    "$(git log --oneline -5 2>/dev/null || echo none)" "$(git status --short 2>/dev/null | grep . || echo clean)"
}

cmd_plan_ctx() {
  resolve || { echo "Not in a git repository: $PWD"; return 0; }
  header
  printf 'Spec:\n%s\nMerge order:\n%s\nExisting plan:\n%s\n' \
    "$(show_file "$plans/spec.md" "NO SPEC")" "$(show_file "$plans/order.md" "single repo")" \
    "$(show_file "$plandir/plan.md" none)"
}

cmd_fix_ctx() { # fix-ctx <check|review|ci>: what a /fix session fixes
  local kind=${1:-}
  resolve || { echo "Not in a git repository: $PWD"; return 0; }
  header
  [ -n "$slug" ] || return 0
  printf 'Spec: %s\n' "$plans/spec.md"
  case $kind in
    check) printf 'Failing check (full output: %s):\n' "$plandir/check.log"; tail -n 80 "$plandir/check.log" 2>/dev/null ;;
    review) printf 'Review (append your Resolution section to this file): %s\n' "$plandir/review.md"
            show_file "$plandir/review.md" "NO REVIEW FOUND" ;;
    ci) printf 'Failing CI run (full log: %s):\n' "$plandir/ci.log"; tail -n 150 "$plandir/ci.log" 2>/dev/null ;;
    *) echo "unknown kind '$kind' (check|review|ci)" ;;
  esac
  printf 'Recent commits:\n%s\nWorking tree:\n%s\n' \
    "$(git log --oneline -8 2>/dev/null || echo none)" "$(git status --short 2>/dev/null | grep . || echo clean)"
}

# --- check -----------------------------------------------------------------------

local_replaces() { # local_replaces <toplevel>: go.mod replaces that point outside the repo
  local top=$1 f old new abs
  command -v go >/dev/null || return 0
  while IFS= read -r f; do
    while IFS=$'\t' read -r old new; do
      case $new in /*) abs=$new ;; *) abs=$(realpath -m "$top/$(dirname "$f")/$new") ;; esac
      case $abs/ in "$top"/*) ;; *) printf '  %s: %s => %s\n' "$f" "$old" "$new" ;; esac
    done < <(go mod edit -json "$top/$f" 2>/dev/null |
      jq -r '.Replace[]? | select(.New.Version == null) | "\(.Old.Path)\t\(.New.Path)"')
  done < <(git -C "$top" ls-files -- ':(glob)**/go.mod')
}

# A repo's .claude/check runs what its CI runs; green means green on CI. A full check that
# passes on a clean tree is remembered per tree, so pushing right after it doesn't rerun it.
failures() { # failures <log>: the lines that say what failed, for a human or a fix session
  local hits
  hits=$(grep -E -A 6 -m 12 -e '^--- FAIL|^FAIL|^panic:|^ERR|[Ee]rror:|FAILED|✗|✖|×' "$1" | head -n 60)
  [ -z "$hits" ] || printf -- '--- what failed:\n%s\n' "$hits"
}

cmd_check() {
  local mode=${1:-} top bad stamp_full stamp_quick stamp tree clean= rc log
  case $mode in ''|--quick) ;; *) die "usage: wt check [--quick]" ;; esac
  top=$(git rev-parse --show-toplevel 2>/dev/null) || die "check: not in a git repository"
  top=$(realpath "$top")
  bad=$(local_replaces "$top")
  if [ -n "$bad" ]; then
    printf 'wt check: go.mod replace points outside the repo; CI has no such path:\n%s\n' "$bad" >&2
    return 1
  fi
  [ -x "$top/.claude/check" ] || { echo "wt check: no .claude/check in $top; nothing to run"; return 0; }
  stamp_full=$(git -C "$top" rev-parse --path-format=absolute --git-path wt-check-ok)
  stamp_quick=$(git -C "$top" rev-parse --path-format=absolute --git-path wt-check-quick-ok)
  stamp=$stamp_full; [ "$mode" = "--quick" ] && stamp=$stamp_quick
  tree=$(git -C "$top" rev-parse -q --verify 'HEAD^{tree}')
  [ -z "$(git -C "$top" status --porcelain)" ] && clean=1
  # full green covers quick; quick green covers only quick
  if [ -n "$clean" ] && [ -n "$tree" ]; then
    if [ "$(cat "$stamp_full" 2>/dev/null)" = "$tree" ]; then
      echo "wt check: already green at $(git -C "$top" rev-parse --short HEAD)"; return 0
    fi
    if [ "$mode" = "--quick" ] && [ "$(cat "$stamp_quick" 2>/dev/null)" = "$tree" ]; then
      echo "wt check: already green at $(git -C "$top" rev-parse --short HEAD)"; return 0
    fi
  fi
  log=$(git -C "$top" rev-parse --path-format=absolute --git-path wt-check.log)
  (cd "$top" && timeout -k 30 "$WT_CHECK_TIMEOUT" ./.claude/check $mode) 2>&1 | tee "$log"; rc=${PIPESTATUS[0]}
  if [ "$rc" -ne 0 ]; then
    if [ "$rc" -eq 124 ]; then echo "wt check: timed out after ${WT_CHECK_TIMEOUT}s; full output: $log"
    else echo "wt check: red (exit $rc); full output: $log"; fi
    failures "$log"
    return 1
  fi
  if [ -n "$clean" ] && [ -z "$(git -C "$top" status --porcelain)" ]; then
    printf '%s\n' "$tree" >"$stamp"
    [ "$mode" = "--quick" ] || printf '%s\n' "$tree" >"$stamp_quick"
  fi
  echo "wt check: green"
}

# --- acceptance --------------------------------------------------------------------

cmd_acceptance() {
  local top xml log args=() rc
  top=$(git rev-parse --show-toplevel 2>/dev/null) || die "acceptance: not in a git repository"
  top=$(realpath "$top")
  if [ ! -x "$top/.claude/acceptance" ]; then
    printf 'wt acceptance: no .claude/acceptance in %s\n' "$top" >&2
    return 3
  fi
  command -v python3 >/dev/null 2>&1 || die "wt acceptance needs python3"
  [ "${1:-}" = "--run" ] && args=(--run "$2")
  xml=$(git -C "$top" rev-parse --path-format=absolute --git-path wt-acceptance.xml)
  log=$(git -C "$top" rev-parse --path-format=absolute --git-path wt-acceptance.log)
  rm -f "$xml"
  (cd "$top" && timeout -k 30 "$WT_ACCEPTANCE_TIMEOUT" ./.claude/acceptance --junit "$xml" "${args[@]}") 2>&1 | tee "$log"; rc=${PIPESTATUS[0]}
  python3 -I - "$xml" <<'PYEOF'
import sys
import xml.etree.ElementTree as ET

try:
    tree = ET.parse(sys.argv[1])
except (OSError, ET.ParseError):
    sys.exit(2)

passed = 0
not_passed = 0
for tc in tree.getroot().iter("testcase"):
    feature = tc.get("classname", "")
    name = tc.get("name", "")
    if tc.find("failure") is not None:
        status = "failed"
    elif tc.find("skipped") is not None:
        status = "skipped"
    elif tc.find("error") is not None:
        status = "error"
    else:
        status = "passed"
    print(f"{status}\t{feature}\t{name}")
    if status == "passed":
        passed += 1
    else:
        not_passed += 1

print(f"wt acceptance: {passed} passed, {not_passed} not passed", file=sys.stderr)
sys.exit(0 if not_passed == 0 else 1)
PYEOF
  return $?
}

# --- worktree lifecycle --------------------------------------------------------

cmd_create() {
  local slug=${1:-} repo=${2:-} repodir
  [ -n "$slug" ] || die "usage: wt create <slug> [repo]"
  locate "$slug"
  if [ -z "$repo" ]; then
    [ -n "${main:-}" ] || die "usage: wt create <slug> <repo> (not inside a repo)"
    repo=$(basename "$main" .git)
  fi
  repodir=$(repo_dir "$ws" "$repo") || die "no repo '$repo' in $ws"
  find_or_create_wt "$slug" "$repo" "$repodir" "$ws" "$plansroot"
}

cmd_remove() {
  local slug=${1:-} repo repodir wt def found=() problems=
  [ -n "$slug" ] || die "usage: wt remove <slug>"
  locate "$slug"
  while IFS= read -r repo; do
    repodir=$(repo_dir "$ws" "$repo") || continue
    wt=$(find_wt "$slug" "$repo" "$repodir" "$ws") || continue
    found+=("$repo:$repodir:$wt")
    [ -z "$(git -C "$wt" status --porcelain 2>/dev/null)" ] || problems="$problems\n  $repo: uncommitted changes in $wt"
    def=$(default_branch "$repodir")
    git -C "$repodir" merge-base --is-ancestor "$slug" "origin/$def" 2>/dev/null || problems="$problems\n  $repo: branch $slug is unmerged into origin/$def"
  done < <(workspace_repos "$ws")
  [ "${#found[@]}" -gt 0 ] || die "no worktrees for $slug under $ws"
  [ -z "$problems" ] || die "refusing to remove $slug:$(printf '%b' "$problems")"
  local entry
  for entry in "${found[@]}"; do
    repo=${entry%%:*}; entry=${entry#*:}; repodir=${entry%%:*}; wt=${entry#*:}
    git -C "$repodir" worktree remove "$wt" && git -C "$repodir" branch -q -d "$slug" && echo "removed $wt"
  done
  rmdir "$ws/.worktrees/$slug" 2>/dev/null || true
}

# --- headless run ----------------------------------------------------------------

plans_for_slug() { # plans_for_slug <slug>: the .plans/<slug> dir for this cwd
  local c
  resolve_workspace "${workspace:-$PWD}"
  case $ws_kind in
    explicit|marked)
      [ -d "$ws_root/.plans/$1" ] && { printf '%s\n' "$ws_root/.plans/$1"; return 0; }
      die_if_legacy_slug "$1"
      return 1
      ;;
    legacy)
      for c in "$PWD/.plans/$1" "${main:+$main/.plans/$1}" "${workspace:+$workspace/.plans/$1}"; do
        [ -n "$c" ] && [ -d "$c" ] && { printf '%s\n' "$c"; return 0; }
      done
      return 1
      ;;
  esac
}

count() { local n; n=$(grep -c -- "$1" "$2" 2>/dev/null); printf '%s\n' "${n:-0}"; } # count <regex> <file>
has_unchecked() { grep -q '^- \[ \]' "$1" 2>/dev/null; }
is_blocked() { grep -q '^ *BLOCKED:' "$1" 2>/dev/null; }
blocked_reason() { sed -n 's/^ *BLOCKED: *//p' "$1" 2>/dev/null | head -1; }
first_open() { awk '/^- \[[ x]\]/ {n++} /^- \[ \]/ {print n; exit}' "$1"; } # index of the first unchecked step
order_repos() { sed -n 's/^Merge order: *//p' "$1/order.md" 2>/dev/null | tr ',' '\n' | tr -d ' ' | grep .; }
pr_count() { [ -f "$1/state.md" ] && awk -v r="$2" '$1 == r {n++} END {print n + 0}' "$1/state.md" || echo 0; }

block_step() { # block_step <plan> <reason>: a BLOCKED line under the first unchecked step
  BLOCK_REASON=$2 awk '!done && /^- \[ \]/ {print; print "  BLOCKED: " ENVIRON["BLOCK_REASON"]; done = 1; next} {print}' \
    "$1" >"$1.tmp" && mv "$1.tmp" "$1"
}

progress() { # progress <phase> <repo> <message>: stdout and the feature's run.log
  local line
  printf -v line '%(%H:%M:%S)T [%s] %s: %s' -1 "$1" "$2" "$3"
  printf '%s\n' "$line"
  [ -z "${RUN_PLANS:-}" ] || printf '%s\n' "$line" >>"$RUN_PLANS/run.log"
}
notify() { # notify <message> [urgency]: a desktop notification, best effort
  command -v notify-send >/dev/null 2>&1 && notify-send -a wt -u "${2:-normal}" "wt: $RUN_SLUG" "$1" >/dev/null 2>&1
  return 0
}
fail() { progress "$1" "$2" "FAILED: $3"; notify "$2: $1 FAILED: $3" critical; }
block() { progress "$1" "$2" "BLOCKED: $3"; notify "$2: BLOCKED: $3" critical; }

last_words() { # last_words <repo> <label>: the end of a session's final message, on one line
  local t
  t=$(tr -s '[:space:]' ' ' <"$RUN_PLANS/$1/log/$2.log" 2>/dev/null)
  t=${t# }; t=${t% }
  [ "${#t}" -le 300 ] || t="...${t: -300}"
  printf '%s\n' "${t:-no final message}"
}

next_label() { # next_label <repo> <label>: <label>, or <label>-2, -3... when a rerun would overwrite its log
  local n=1 l=$2
  while [ -e "$RUN_PLANS/$1/log/$l.jsonl" ]; do n=$((n + 1)); l=$2-$n; done
  printf '%s\n' "$l"
}

ACTIVITY_JQ='
def one(s): (s | tostring | gsub("\\s+"; " "))[0:120];
fromjson? |
if .type == "assistant" then
  (if .parent_tool_use_id then "  sub " else "" end) as $who
  | .message.content[]?
  | if .type == "tool_use" then
      "\($who)\(.name) \(one(.input.description // .input.command // .input.file_path // .input.pattern // .input.prompt // .input))"
    elif .type == "text" and $who == "" then "says: \(one(.text))"
    else empty end
elif .type == "result" then
  "result: \(.subtype // "?") \((.duration_ms // 0) / 1000 | floor)s \(.num_turns // 0) turns $\(.total_cost_usd // 0)"
else empty end'

activity() { # activity <who>: one timestamped line per action of a stream-json transcript on stdin
  local line
  jq --unbuffered -Rr "$ACTIVITY_JQ" | while IFS= read -r line; do
    printf '%(%H:%M:%S)T   %s  %s\n' -1 "$1" "$line"
  done
}

session_stats() { # session_stats <repo> <label> <rc> <jsonl>: a sessions.tsv row; sets LAST_STATS
  local stats
  stats=$(jq -R 'fromjson?' "$4" 2>/dev/null | jq -rs '
    ([.[] | select(.type == "result")] | last // {}) as $r
    | ([.[] | select(.type == "assistant" and (.parent_tool_use_id | not)) | .message.usage
        | (.input_tokens // 0) + (.cache_read_input_tokens // 0) + (.cache_creation_input_tokens // 0)]
       | max // 0) as $ctx
    | [($r.num_turns // 0), (($r.duration_ms // 0) / 1000 | floor), ($r.total_cost_usd // 0), $ctx] | @tsv')
  [ -n "$stats" ] || stats=$(printf '0\t0\t0\t0')
  printf '%(%F %T)T\t%s\t%s\t%s\t%s\n' -1 "$1" "$2" "$3" "$stats" >>"$RUN_PLANS/sessions.tsv"
  LAST_STATS=$(awk -F'\t' '{
    printf "%ds, $%.2f, %dk ctx", $2, $3, ($4 + 500) / 1000
    if ($4 > 100000) printf ", over 100k"
  }' <<<"$stats")
}

run_step() { # run_step <repo> <label> <prompt> [claude args...]: one headless session
  local repo=$1 label=$2 prompt=$3 dir base rc; shift 3
  dir=$(find_or_create_wt "$RUN_SLUG" "$repo" "$(repo_dir "$RUN_WS" "$repo")" "$RUN_WS" "$RUN_PLANSROOT") || return 1
  base=$RUN_PLANS/$repo/log/$label; mkdir -p "$(dirname "$base")"
  # .jsonl is the full transcript (every tool call and result), .log the final message, and
  # run.log gets one line per action. The session is told its slug: never re-derived.
  (cd "$dir" && WT_SLUG=$RUN_SLUG WORKSPACE=$RUN_ROOT \
    claude -p "$prompt" --add-dir "$RUN_PLANS" --output-format stream-json --verbose "$@" \
      </dev/null 2>"$base.err" 9>&- | tee -p "$base.jsonl" | activity "$repo/$label" >>"$RUN_PLANS/run.log"
    exit "${PIPESTATUS[0]}")
  rc=$?
  { jq -r 'select(.type == "result") | .result // empty' "$base.jsonl" 2>/dev/null
    [ -s "$base.err" ] && { echo "stderr:"; cat "$base.err"; }
  } >"$base.log"
  rm -f "$base.err"
  session_stats "$repo" "$label" "$rc" "$base.jsonl"
  return $rc
}

run_plan() {
  local repo=$1 plan=$RUN_PLANS/$1/plan.md label
  [ -f "$plan" ] && { progress plan "$repo" "exists, skipping"; return 0; }
  progress plan "$repo" started
  label=$(next_label "$repo" plan)
  run_step "$repo" "$label" "/steps" || { fail plan "$repo" "session failed: $(last_words "$repo" "$label")"; return 1; }
  if is_blocked "$plan"; then block plan "$repo" "$(blocked_reason "$plan")"; return 1; fi
  has_unchecked "$plan" || { fail plan "$repo" "no plan written: $(last_words "$repo" "$label")"; return 1; }
  progress plan "$repo" "done ($(count '^- \[ \]' "$plan") slices; $LAST_STATS)"
}

run_tdd() { # one session per slice; check --quick after each; no-progress blocks the plan
  local repo=$1 plan=$RUN_PLANS/$1/plan.md dir i=0 before label total n
  [ -f "$plan" ] || { fail tdd "$repo" "no plan"; return 1; }
  dir=$(find_or_create_wt "$RUN_SLUG" "$repo" "$(repo_dir "$RUN_WS" "$repo")" "$RUN_WS" "$RUN_PLANSROOT") || return 1
  total=$(count '^- \[[ x]\]' "$plan")
  n=$total; [ "$n" -eq 1 ] && n="1 slice" || n="$n slices"
  progress tdd "$repo" "starting ($n)"
  while [ "$i" -lt "$MAX_STEPS" ] && has_unchecked "$plan" && ! is_blocked "$plan"; do
    i=$((i + 1)); before=$(count '^- \[x\]' "$plan")
    label=$(next_label "$repo" "slice-$(printf '%02d' "$(first_open "$plan")")")
    progress tdd "$repo" "slice $i"
    run_step "$repo" "$label" "/tdd" || { fail tdd "$repo" "slice $i: session failed: $(last_words "$repo" "$label")"; return 1; }
    if ! is_blocked "$plan" && [ "$(count '^- \[x\]' "$plan")" -le "$before" ]; then
      block_step "$plan" "slice not finished; the session said: $(last_words "$repo" "$label")"
    fi
    if ! is_blocked "$plan"; then
      progress tdd "$repo" "slice $i done ($LAST_STATS)"
      check_green_tdd "$repo" "$dir" "$plan" || return 1
    fi
  done
  if is_blocked "$plan"; then block tdd "$repo" "$(blocked_reason "$plan")"; return 1; fi
  has_unchecked "$plan" && { fail tdd "$repo" "stopped after $MAX_STEPS sessions with slices left"; return 1; }
  progress tdd "$repo" "done ($(count '^- \[x\]' "$plan")/$total)"
}

# --- ship: rebase, check, review and fixes per repo; e2e once; then push and PRs in merge order

wt_dir() { find_wt "$RUN_SLUG" "$1" "$(repo_dir "$RUN_WS" "$1")" "$RUN_WS"; } # wt_dir <repo>
block_end() { printf 'BLOCKED: %s\n' "$2" >>"$1"; } # block_end <plan> <reason>: stops reruns until cleared
stop_ship() { block_end "$RUN_PLANS/$1/plan.md" "$2"; block ship "$1" "$2"; } # stop_ship <repo> <reason>
session_blocked() { sed -n 's/^BLOCKED: *//p' "$RUN_PLANS/$1/log/$2.log" 2>/dev/null | head -1 | grep .; }
serious() { count '^- \(BLOCKER\|MAJOR\) ' "$1"; } # serious <review>: blocker and major findings
section_drop() { awk -v re="^## ($2)\$" '$0 ~ re {skip = 1; next} /^## / {skip = 0} !skip' "$1" 2>/dev/null; }
section() { awk -v h="## $2" '$0 == h {on = 1; next} /^## / {on = 0} on' "$1" 2>/dev/null | sed '/./,$!d'; }

fix_session() { # fix_session <repo> <kind>: one /fix session; a BLOCKED answer stops the repo
  local label why
  label=$(next_label "$1" "fix-$2")
  run_step "$1" "$label" "/fix $2" || { fail ship "$1" "fix session failed: $(last_words "$1" "$label")"; return 1; }
  why=$(session_blocked "$1" "$label") && { stop_ship "$1" "$why"; return 1; }
  return 0
}

sync_default() { # sync_default <repo> <dir>: a clean tree, rebased onto fresh origin/<default>
  local def dirty
  dirty=$(git -C "$2" status --porcelain)
  [ -z "$dirty" ] || { stop_ship "$1" "uncommitted or untracked files in $2: $(printf '%s' "$dirty" | head -5 | paste -sd ' ')"; return 1; }
  def=$(default_branch "$2")
  timeout 60 git -C "$2" fetch -q origin 2>/dev/null || progress ship "$1" "fetch failed; using the last known origin/$def"
  git -C "$2" merge-base --is-ancestor "origin/$def" HEAD && return 0
  if git -C "$2" rebase -q "origin/$def" >/dev/null 2>&1; then progress ship "$1" "rebased onto origin/$def"; return 0; fi
  git -C "$2" rebase --abort 2>/dev/null
  stop_ship "$1" "conflicts with origin/$def; run /rebase in $2"
  return 1
}

untick_last() { # untick_last <plan>: revert the last ticked step back to unchecked
  local last_n
  last_n=$(awk '/^- \[x\]/ {n = NR} END {print n}' "$1")
  [ -n "$last_n" ] && sed -i "${last_n}s/^- \[x\]/- [ ]/" "$1"
}

fix_session_tdd() { # fix_session_tdd <repo> <kind> <plan>: like fix_session but blocks via tdd progress
  local label why
  label=$(next_label "$1" "fix-$2")
  run_step "$1" "$label" "/fix $2" || { fail tdd "$1" "fix session failed: $(last_words "$1" "$label")"; return 1; }
  why=$(session_blocked "$1" "$label") && { block_step "$3" "$why"; block tdd "$1" "$why"; return 1; }
  return 0
}

check_green_tdd() { # check_green_tdd <repo> <dir> <plan>: wt check --quick after a slice; red unticks + blocks
  local repo=$1 dir=$2 plan=$3 try=0
  (cd "$dir" && "$WT_SELF" check --quick) >"$RUN_PLANS/$repo/check.log" 2>&1 && return 0
  while [ "$try" -lt 2 ]; do
    try=$((try + 1))
    progress tdd "$repo" "check red; fix session $try"
    fix_session_tdd "$repo" check "$plan" || { untick_last "$plan"; return 1; }
    (cd "$dir" && "$WT_SELF" check --quick) >"$RUN_PLANS/$repo/check.log" 2>&1 && return 0
  done
  # still red: untick the slice and block it
  untick_last "$plan"
  block_step "$plan" "check still red after 2 fix sessions (see $RUN_PLANS/$repo/check.log)"
  block tdd "$repo" "check still red after 2 fix sessions (see $RUN_PLANS/$repo/check.log)"
  return 1
}

check_green() { # check_green <repo> <dir>: wt check, with up to 2 /fix check sessions on red
  local repo=$1 dir=$2 try=0
  until (cd "$dir" && "$WT_SELF" check) >"$RUN_PLANS/$repo/check.log" 2>&1; do
    try=$((try + 1))
    [ "$try" -le 2 ] || { stop_ship "$repo" "check still red after 2 fix sessions (see $RUN_PLANS/$repo/check.log)"; return 1; }
    progress ship "$repo" "check red; fix session $try"
    fix_session "$repo" check || return 1
  done
  progress ship "$repo" "check green"
}

review_prompt() { # review_prompt <repo> <dir> <base> <earlier review>
  printf 'Review the changes on this branch: `git diff %s..HEAD` in %s (repo %s).\n' "$3" "$2" "$1"
  printf 'Spec: %s\n' "$( [ -f "$RUN_PLANS/spec.md" ] && echo "$RUN_PLANS/spec.md" || echo none)"
  [ -f "$4" ] && printf 'An earlier review of this branch, with how each finding was resolved, is at %s. Do not re-raise a finding resolved there unless the code still shows it; then say why the resolution is wrong.\n' "$4"
  printf 'Follow your code review instructions and output exactly the format they define.\n'
}

rereview_prompt() { # rereview_prompt <repo> <dir> <pre-fix sha> <review>
  printf 'Re-review only the fix commits: `git diff %s..HEAD` in %s (repo %s).\n' "$3" "$2" "$1"
  printf 'They address the BLOCKER and MAJOR findings in %s, resolved as its Resolution section says.\n' "$4"
  printf 'Check that each fix is correct and complete and adds no new BLOCKER or MAJOR. Raise nothing about code outside that diff and no MINOR or NIT. Output only the Findings section of your format.\n'
}

run_review() { # run_review <repo> <dir>: review, a verified fix round, one re-review of the fixes
  local repo=$1 dir=$2 plandir=$RUN_PLANS/$1 base label n pre
  base=$(git -C "$dir" merge-base HEAD "origin/$(default_branch "$dir")")
  label=$(next_label "$repo" review)
  run_step "$repo" "$label" "$(review_prompt "$repo" "$dir" "$base" "$plandir/review.md")" --agent reviewer ||
    { fail ship "$repo" "review session failed: $(last_words "$repo" "$label")"; return 1; }
  cp "$plandir/log/$label.log" "$plandir/review.md"
  n=$(serious "$plandir/review.md")
  progress ship "$repo" "review: $n blocker/major ($LAST_STATS)"
  [ "$n" -gt 0 ] || return 0
  pre=$(git -C "$dir" rev-parse HEAD)
  fix_session "$repo" review && check_green "$repo" "$dir" || return 1
  label=$(next_label "$repo" rereview)
  run_step "$repo" "$label" "$(rereview_prompt "$repo" "$dir" "$pre" "$plandir/review.md")" --agent reviewer ||
    { fail ship "$repo" "re-review session failed: $(last_words "$repo" "$label")"; return 1; }
  { printf '\n## Re-review of the fixes\n'; section_drop "$plandir/log/$label.log" 'Title|Summary' | sed 's/^## /### /'; } >>"$plandir/review.md"
  n=$(serious "$plandir/log/$label.log")
  [ "$n" -eq 0 ] || { stop_ship "$repo" "review: $n blocker/major left after one fix round (see $plandir/review.md)"; return 1; }
  progress ship "$repo" "fixes re-reviewed: clean"
}

run_verify() { # run_verify <repo>: everything before the push; skipped once the repo has a PR
  local repo=$1 plan=$RUN_PLANS/$1/plan.md dir
  [ "$(pr_count "$RUN_PLANS" "$repo")" -eq 0 ] || { progress ship "$repo" "PR already open"; return 0; }
  if has_unchecked "$plan" || is_blocked "$plan"; then fail ship "$repo" "the plan has unfinished or blocked steps"; return 1; fi
  dir=$(wt_dir "$repo") || { fail ship "$repo" "no worktree"; return 1; }
  progress ship "$repo" started
  sync_default "$repo" "$dir" && check_green "$repo" "$dir" && run_review "$repo" "$dir"
}

run_e2e() { # run_e2e <repos...>: the spec's `E2E:` command, once, in the last repo's worktree
  local cmd last dir rc reason
  cmd=$(sed -n 's/^E2E: *//p' "$RUN_PLANS/spec.md" 2>/dev/null | head -1)
  case $cmd in
    '') E2E_NOTE="E2E: the spec has no E2E line"; progress ship "$RUN_SLUG" "no E2E line in the spec; skipped"; return 0 ;;
    none*) E2E_NOTE="E2E: $cmd"; progress ship "$RUN_SLUG" "e2e: $cmd"; return 0 ;;
  esac
  last=${!#}; dir=$(wt_dir "$last")
  progress ship "$RUN_SLUG" "e2e: $cmd"
  (cd "$dir" && timeout -k 30 "$WT_CHECK_TIMEOUT" bash -c "$cmd") >"$RUN_PLANS/e2e.log" 2>&1; rc=$?
  if [ "$rc" -ne 0 ]; then
    reason="e2e failed (exit $rc): $(grep . "$RUN_PLANS/e2e.log" | tail -n 1)"
    block_end "$RUN_PLANS/$last/plan.md" "$reason"; block ship "$RUN_SLUG" "$reason"
    return 1
  fi
  E2E_NOTE="E2E: \`$cmd\` passed"
  progress ship "$RUN_SLUG" "e2e passed"
}

push_branch() { # push_branch <repo> <dir>: bounded, so a locked SSH agent can't hang the run
  local rc
  GIT_TERMINAL_PROMPT=0 timeout "$WT_PUSH_TIMEOUT" git -C "$2" push -q -u origin "HEAD:refs/heads/$(git -C "$2" branch --show-current)" \
    >"$RUN_PLANS/$1/push.log" 2>&1; rc=$?
  [ "$rc" -ne 0 ] || return 0
  if [ "$rc" -eq 124 ]; then fail ship "$1" "push timed out after ${WT_PUSH_TIMEOUT}s; is the SSH agent (1Password) unlocked? Then wt build $RUN_SLUG again"
  else fail ship "$1" "push failed: $(grep . "$RUN_PLANS/$1/push.log" | tail -n 1)"; fi
  return 1
}

open_pr() { # open_pr <dir> <base> <title> <body file>: prints the PR URL; nothing for an unknown host
  local url host path branch
  url=$(git -C "$1" config --get remote.origin.url); branch=$(git -C "$1" branch --show-current)
  case $url in
    *github.com[:/]*)
      (cd "$1" && gh pr create --base "$2" --head "$branch" --title "$3" --body-file "$4") | grep -o 'https://[^ ]*' | tail -n 1 ;;
    *codebahn.net[:/]*)
      host=${url#*://}; host=${host#*@}; host=${host%%[:/]*}
      path=${url#*"$host"}; path=${path#[:/]}; path=${path%.git}
      codebahn pr create --owner "${path%%/*}" --repo "${path#*/}" --head "$branch" --base "$2" --title "$3" \
        --body "$(cat "$4")" --instance "https://$host" --json | jq -r '.html_url // empty' ;;
  esac
}

pr_body() { # pr_body <index> <total> <repo>: the reviewer's summary, merge order, e2e, and the review
  local i=$1 total=$2 review=$RUN_PLANS/$3/review.md prev
  section "$review" Summary
  if [ "$total" -gt 1 ]; then
    prev=$(awk -v r="$(order_repos "$RUN_PLANS" | sed -n "$((i - 1))p")" '$1 == r {u = $2} END {print u}' "$RUN_PLANS/state.md" 2>/dev/null)
    printf '\nMerge order: %s of %s (%s)%s\n' "$i" "$total" "$(order_repos "$RUN_PLANS" | paste -sd, | sed 's/,/, /g')" \
      "${prev:+; merge after $prev}"
  fi
  printf '\n%s\n\n## Review\n\n' "$E2E_NOTE"
  section_drop "$review" 'Title|Summary' | sed 's/^## /### /'
}

publish() { # publish <index> <total> <repo>: push, open the PR, record it in state.md
  local i=$1 total=$2 repo=$3 dir title body url
  dir=$(wt_dir "$repo")
  if [ "$(pr_count "$RUN_PLANS" "$repo")" -gt 0 ]; then
    push_branch "$repo" "$dir" && progress ship "$repo" "pushed to its open PR"; return
  fi
  check_green "$repo" "$dir" && push_branch "$repo" "$dir" || return 1
  title=$(section "$RUN_PLANS/$repo/review.md" Title | head -n 1)
  [ -n "$title" ] || title=$(sed -n 's/^# *//p' "$RUN_PLANS/spec.md" 2>/dev/null | head -n 1)
  body=$RUN_PLANS/$repo/pr.md; pr_body "$i" "$total" "$repo" >"$body"
  url=$(open_pr "$dir" "$(default_branch "$dir")" "${title:-$RUN_SLUG}" "$body")
  if [ -n "$url" ]; then
    echo "$repo $url open" >>"$RUN_PLANS/state.md"; progress ship "$repo" "PR $url"
  else
    echo "$repo - pushed" >>"$RUN_PLANS/state.md"; progress ship "$repo" "pushed; open the PR by hand"
  fi
  progress ship "$repo" done
}

# --- CI watch: poll each PR's CI, fix red runs, re-push ---

WT_CI_POLL=${WT_CI_POLL:-30}       # seconds between polls
WT_CI_TIMEOUT=${WT_CI_TIMEOUT:-900} # give up after 15 min

ci_host() { # ci_host <repo>: github, codebahn, or empty (unknown)
  local url
  url=$(git -C "$(wt_dir "$1")" config --get remote.origin.url 2>/dev/null)
  case $url in *github.com[:/]*) echo github ;; *codebahn.net[:/]*) echo codebahn ;; esac
}

ci_status_github() { # ci_status_github <repo> <pr_url>: success, failure, pending, or empty
  local pr_num owner_repo checks state
  pr_num=${2##*/}
  owner_repo=$(echo "$2" | sed -n 's|https://github.com/\([^/]*/[^/]*\)/pull/.*|\1|p')
  checks=$(gh pr checks "$pr_num" --repo "$owner_repo" --json state 2>/dev/null) || return 0
  state=$(jq -r '.[0].state // empty' <<<"$checks")
  case $state in SUCCESS) echo success ;; FAILURE) echo failure ;; PENDING|"") echo pending ;; *) echo "$state" ;; esac
}

ci_status_codebahn() { # ci_status_codebahn <repo> <pr_url>: success, failure, pending, or empty
  local sha dir runs status
  dir=$(wt_dir "$1")
  sha=$(git -C "$dir" rev-parse HEAD)
  local host path
  local url; url=$(git -C "$dir" config --get remote.origin.url)
  host=${url#*://}; host=${host#*@}; host=${host%%[:/]*}
  path=${url#*"$host"}; path=${path#[:/]}; path=${path%.git}
  runs=$(codebahn ci list --owner "${path%%/*}" --repo "${path#*/}" --head_sha "$sha" --instance "https://$host" --json 2>/dev/null) || return 0
  status=$(jq -r '.workflow_runs[0].status // empty' <<<"$runs")
  case $status in success) echo success ;; failure) echo failure ;; waiting|running) echo pending ;; cancelled) echo cancelled ;; *) echo "$status" ;; esac
}

ci_logs_codebahn() { # ci_logs_codebahn <repo> <pr_url>: fetch failing job logs to ci.log
  local dir sha url host path runs run_id
  dir=$(wt_dir "$1"); sha=$(git -C "$dir" rev-parse HEAD)
  url=$(git -C "$dir" config --get remote.origin.url)
  host=${url#*://}; host=${host#*@}; host=${host%%[:/]*}
  path=${url#*"$host"}; path=${path#[:/]}; path=${path%.git}
  runs=$(codebahn ci list --owner "${path%%/*}" --repo "${path#*/}" --head_sha "$sha" --instance "https://$host" --json 2>/dev/null)
  run_id=$(jq -r '.workflow_runs[0].id // empty' <<<"$runs")
  [ -n "$run_id" ] || return 0
  codebahn ci logs --owner "${path%%/*}" --repo "${path#*/}" --run_id "$run_id" --instance "https://$host" --json 2>/dev/null |
    jq -r '.jobs[]? | select(.status == "failure") | .lines[]?.message' >"$RUN_PLANS/$1/ci.log" 2>/dev/null
}

ci_logs_github() { # ci_logs_github <repo> <pr_url>: a summary of the failing checks
  local pr_num owner_repo
  pr_num=${2##*/}
  owner_repo=$(echo "$2" | sed -n 's|https://github.com/\([^/]*/[^/]*\)/pull/.*|\1|p')
  gh pr checks "$pr_num" --repo "$owner_repo" 2>/dev/null | grep -i fail >"$RUN_PLANS/$1/ci.log" 2>/dev/null
}

poll_ci() { # poll_ci <repo> <pr_url> <host>: wait for CI, return 0 green / 1 red / 2 timeout
  local elapsed=0 status
  while [ "$elapsed" -lt "$WT_CI_TIMEOUT" ]; do
    case $3 in
      github) status=$(ci_status_github "$1" "$2") ;;
      codebahn) status=$(ci_status_codebahn "$1" "$2") ;;
    esac
    case $status in
      success) return 0 ;;
      failure) return 1 ;;
      cancelled) return 1 ;;
    esac
    sleep "$WT_CI_POLL"; elapsed=$((elapsed + WT_CI_POLL))
  done
  return 2
}

watch_ci() { # watch_ci <repos...>: after PRs are open, poll CI and fix red runs
  local repo pr_url host rc dir
  for repo in "$@"; do
    pr_url=$(awk -v r="$repo" '$1 == r {u = $2} END {print u}' "$RUN_PLANS/state.md" 2>/dev/null)
    [ -n "$pr_url" ] && [ "$pr_url" != "-" ] || continue
    host=$(ci_host "$repo")
    [ -n "$host" ] || continue
    progress ci "$repo" "polling CI ($host)"
    local try=0
    while :; do
      poll_ci "$repo" "$pr_url" "$host"; rc=$?
      if [ "$rc" -eq 0 ]; then progress ci "$repo" "CI green"; break; fi
      if [ "$rc" -eq 2 ]; then progress ci "$repo" "CI timed out after ${WT_CI_TIMEOUT}s; check it by hand"; break; fi
      # red: fetch logs and try to fix
      try=$((try + 1))
      case $host in
        github) ci_logs_github "$repo" "$pr_url" ;;
        codebahn) ci_logs_codebahn "$repo" "$pr_url" ;;
      esac
      if [ "$try" -gt 2 ]; then
        block_end "$RUN_PLANS/$repo/plan.md" "CI still red after 2 fix sessions (see $RUN_PLANS/$repo/ci.log)"
        block ci "$repo" "CI still red after 2 fix sessions (see $RUN_PLANS/$repo/ci.log)"
        return 1
      fi
      progress ci "$repo" "CI red; fix session $try"
      dir=$(wt_dir "$repo")
      fix_session "$repo" ci || return 1
      check_green "$repo" "$dir" || return 1
      push_branch "$repo" "$dir" || return 1
    done
  done
}

run_phase_parallel() { # run_phase_parallel <fn> <repos...>
  local fn=$1 pids=() rc=0 pid; shift
  for repo in "$@"; do "$fn" "$repo" & pids+=($!); done
  for pid in "${pids[@]}"; do wait "$pid" || rc=1; done
  return $rc
}

repo_lines() { # repo_lines <plans> <repos...>: steps done, BLOCKED question, PR per repo
  local plans=$1 repo plan blocked pr line; shift
  for repo in "$@"; do
    plan=$plans/$repo/plan.md
    line="$repo: $(count '^- \[x\]' "$plan")/$(count '^- \[[ x]\]' "$plan") slices done"
    blocked=$(blocked_reason "$plan")
    pr=$(awk -v r="$repo" '$1 == r {u = $2} END {print u}' "$plans/state.md" 2>/dev/null)
    [ -n "$blocked" ] && line="$line, BLOCKED: $blocked"
    case $pr in '') ;; -) line="$line, pushed $(basename "$plans") (open the PR by hand)" ;; *) line="$line, PR $pr" ;; esac
    echo "$line"
  done
}

register() { # remember a feature's plans dir, so wt status finds it from anywhere
  mkdir -p "$STATE_DIR"
  grep -qxF -- "$1" "$STATE_DIR/runs" 2>/dev/null || printf '%s\n' "$1" >>"$STATE_DIR/runs"
}

is_running() { [ -f "$1/.run.lock" ] && ! flock -n "$1/.run.lock" true; } # is_running <plans>

cmd_run() {
  local slug=${1:-} phase=${2:-all} only=${3:-} repos=() repo rc=0
  [ -n "$slug" ] || die "usage: wt run <slug> [plan|tdd|ship|all] [repo]"
  case $phase in plan|tdd|ship|all) ;; *) die "unknown phase '$phase' (plan|tdd|ship|all)" ;; esac
  resolve_git || true
  RUN_SLUG=$slug
  RUN_PLANS=$(plans_for_slug "$slug") || die "no .plans/$slug found; run /spec first"
  RUN_PLANSROOT=$(dirname "$RUN_PLANS")
  RUN_ROOT=$(dirname "$RUN_PLANSROOT")
  if [ -e "$RUN_ROOT/.git" ]; then RUN_WS=$(dirname "$RUN_ROOT"); else RUN_WS=$RUN_ROOT; fi
  export RUN_SLUG RUN_PLANS RUN_PLANSROOT RUN_ROOT RUN_WS
  mapfile -t repos < <(order_repos "$RUN_PLANS")
  [ "${#repos[@]}" -gt 0 ] || die "$RUN_PLANS/order.md has no 'Merge order: repo1, repo2' line"
  if [ -n "$only" ]; then
    printf '%s\n' "${repos[@]}" | grep -qxF -- "$only" || die "repo '$only' is not in the merge order"
    repos=("$only")
  fi
  for repo in "${repos[@]}"; do repo_dir "$RUN_WS" "$repo" >/dev/null || die "no repo '$repo' in $RUN_WS"; done

  exec 9>>"$RUN_PLANS/.run.lock"
  flock -n 9 || die "$slug is already running; wt status $slug"
  echo $$ >"$RUN_PLANS/run.pid"
  if [ -n "${WT_UNIT:-}" ]; then echo "$WT_UNIT" >"$RUN_PLANS/run.unit"; else rm -f "$RUN_PLANS/run.unit"; fi
  unset WT_UNIT
  register "$RUN_PLANS"
  progress run "$slug" "started ($phase${only:+, $only})"

  case $phase in plan|all) run_phase_parallel run_plan "${repos[@]}" || rc=1 ;; esac
  case $phase in tdd|all) [ "$rc" -eq 0 ] && { run_phase_parallel run_tdd "${repos[@]}" || rc=1; } ;; esac
  case $phase in ship|all)
    [ "$rc" -eq 0 ] && { run_phase_parallel run_verify "${repos[@]}" || rc=1; }
    [ "$rc" -eq 0 ] && { run_e2e "${repos[@]}" || rc=1; }
    if [ "$rc" -eq 0 ]; then
      local i=0
      for repo in "${repos[@]}"; do i=$((i + 1)); publish "$i" "${#repos[@]}" "$repo" || { rc=1; break; }; done
    fi
    [ "$rc" -eq 0 ] && { watch_ci "${repos[@]}" || rc=1; } ;;
  esac
  if [ "$rc" -eq 0 ]; then
    progress run "$slug" "finished $phase"
    notify "finished $phase: $(repo_lines "$RUN_PLANS" "${repos[@]}" | paste -sd ';' | sed 's/;/; /g')"
  else
    progress run "$slug" stopped
  fi
  echo "== $slug =="
  repo_lines "$RUN_PLANS" "${repos[@]}"
  echo "Live log: $RUN_PLANS/run.log; transcripts: $RUN_PLANS/<repo>/log/"
  return $rc
}

env_flags() { # systemd-run -E flags: the caller's environment, minus a Claude session's own
  local v
  for v in $(compgen -e); do
    case $v in CLAUDECODE|CLAUDE_CODE_*|CLAUDE_ENV_FILE|CLAUDE_PROJECT_DIR|WT_UNIT|PWD|OLDPWD|SHLVL|_|TMUX|TMUX_PANE) continue ;; esac
    [[ ${!v} == *$'\n'* ]] && continue
    printf -- '-E\n%s\n' "$v"
  done
}

cmd_build() { # the same run, detached: survives this terminal or Claude session
  local slug=${1:-} plans unit flags=()
  [ -n "$slug" ] || die "usage: wt build <slug> [plan|tdd|ship|all] [repo]"
  resolve_git || true
  plans=$(plans_for_slug "$slug") || die "no .plans/$slug found; run /spec first"
  is_running "$plans" && die "$slug is already running; wt status $slug"
  unit=wt-$slug-$(printf '%s' "$plans" | md5sum | cut -c1-4)
  mapfile -t flags < <(env_flags)
  systemd-run --user --collect --quiet --same-dir --unit="$unit" --description="wt run $*" \
    "${flags[@]}" -E "WT_UNIT=$unit" -- "$WT_SELF" run "$@" || die "systemd-run could not start $unit"
  printf 'started %s in the background (unit %s)\n  wt watch %s    follow it live\n  wt status          every feature\n  wt stop %s     cancel it\n' \
    "$slug" "$unit" "$slug" "$slug"
}

feature_state() { # feature_state <plans>: running, blocked, failed, done (every PR open) or idle
  local plans=$1 p r repos=()
  is_running "$plans" && { echo running; return; }
  for p in "$plans"/*/plan.md; do is_blocked "$p" && { echo blocked; return; }; done
  last_progress "$plans" 1 | grep -q 'FAILED' && { echo failed; return; }
  mapfile -t repos < <(order_repos "$plans")
  [ "${#repos[@]}" -gt 0 ] || { echo idle; return; }
  for r in "${repos[@]}"; do [ "$(pr_count "$plans" "$r")" -gt 0 ] || { echo idle; return; }; done
  echo done
}
last_progress() { grep -E '^[0-9:]{8} \[' "$1/run.log" 2>/dev/null | grep -v '^[0-9:]* \[run\]' | tail -n "${2:-1}"; }

cmd_status() {
  local slug=${1:-} plans state repos=()
  resolve_git || true
  if [ -z "$slug" ]; then
    [ -f "$STATE_DIR/runs" ] || { echo "no runs yet"; return 0; }
    while IFS= read -r plans; do
      [ -f "$plans/run.log" ] || continue
      state=$(feature_state "$plans")
      printf '%-28s %-8s %s\n' "$(basename "$plans")" "$state" "$(last_progress "$plans" 1)"
    done <"$STATE_DIR/runs"
    return 0
  fi
  plans=$(plans_for_slug "$slug") || die "no .plans/$slug found"
  mapfile -t repos < <(order_repos "$plans")
  printf '%s: %s (%s)\n' "$slug" "$(feature_state "$plans")" "$plans"
  repo_lines "$plans" "${repos[@]}"
  awk -F'\t' '{n++; s += $6; c += $7} END {if (n) printf "%d sessions, %dm%02ds, $%.2f\n", n, s / 60, s % 60, c}' \
    "$plans/sessions.tsv" 2>/dev/null
  last_progress "$plans" 5
  is_running "$plans" && printf 'now: %s\n' "$(grep -E '^[0-9:]{8}   ' "$plans/run.log" | tail -1)"
  return 0
}

cmd_watch() {
  local slug=${1:-} plans pid
  [ -n "$slug" ] || die "usage: wt watch <slug>"
  resolve_git || true
  plans=$(plans_for_slug "$slug") || die "no .plans/$slug found"
  [ -f "$plans/run.log" ] || die "$slug has not run yet"
  if is_running "$plans" && pid=$(cat "$plans/run.pid" 2>/dev/null) && [ -n "$pid" ]; then
    tail -n 40 -F --pid="$pid" "$plans/run.log"
  else
    tail -n 40 "$plans/run.log"
  fi
}

cmd_stop() {
  local slug=${1:-} plans
  [ -n "$slug" ] || die "usage: wt stop <slug>"
  resolve_git || true
  plans=$(plans_for_slug "$slug") || die "no .plans/$slug found"
  is_running "$plans" || { echo "$slug is not running"; return 0; }
  [ -f "$plans/run.unit" ] || die "$slug runs in a terminal, not under systemd; stop it there"
  systemctl --user stop "$(cat "$plans/run.unit")"
}

# --- main -------------------------------------------------------------------------

no_nested_run() { # a run's sessions inherit RUN_SLUG from cmd_run; they must not start real runs
  [ -z "${RUN_SLUG:-}" ] || die "refusing to start a run inside the run of $RUN_SLUG; builds don't start builds"
}

cmd=${1:-}; [ $# -gt 0 ] && shift
case $cmd in
  ctx) cmd_ctx ;;
  here) cmd_here ;;
  slug) cmd_slug ;;
  tdd) cmd_tdd ;;
  plan-ctx) cmd_plan_ctx ;;
  fix-ctx) cmd_fix_ctx "$@" ;;
  check) cmd_check "$@" ;;
  acceptance) cmd_acceptance "$@" ;;
  create) cmd_create "$@" ;;
  remove) cmd_remove "$@" ;;
  run) no_nested_run; cmd_run "$@" ;;
  build) no_nested_run; cmd_build "$@" ;;
  status) cmd_status "$@" ;;
  watch) cmd_watch "$@" ;;
  stop) cmd_stop "$@" ;;
  ''|-h|--help|help) usage ;;
  *) usage >&2; die "unknown command '$cmd'" ;;
esac
