#!/usr/bin/env bash
# What CI runs. --quick runs the same fast suite (nothing slower exists yet).
set -u
cd "$(dirname "$0")/.."

AGENT_CONFIG=${AGENT_CONFIG:-$HOME/code/agent-config}

if [ -d "$AGENT_CONFIG" ]; then
  bash "$AGENT_CONFIG/bin/wt.test.sh"
  rc1=$?
  bash "$AGENT_CONFIG/test/hooks.test.sh"
  rc2=$?
  [ $rc1 -eq 0 ] && [ $rc2 -eq 0 ]
else
  echo "agent-config not found at $AGENT_CONFIG; skipping tests"
fi
